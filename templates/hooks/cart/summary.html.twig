{% if sylius.channel.themeName != industry_theme_name %}
    {% include '@SyliusShop/cart/index/content/form/sections/general/summary.html.twig' %}
{% else %}
{# Rendered with \Sylius\Bundle\ShopBundle\Twig\Component\Cart\SummaryComponent #}
{# Comme le cœur, avec un titre h2 : la page n'a qu'un h1, un h3 sauterait un niveau. #}
{% import '@SyliusShop/shared/macro/loader.html.twig' as loader %}

<div class="position-relative" {{ attributes }}>
    {{ loader.render() }}
    <div class="p-4 bg-light mb-4 rounded-3 industry-cart-summary">
        <h2 class="h3 mb-4">{{ 'sylius.ui.summary'|trans }}</h2>
        {% hook 'summary' with {cart} %}
    </div>
</div>
{% endif %}
