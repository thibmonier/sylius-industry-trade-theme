{# US-226 : mode sombre optionnel. Script du <head>, exécuté avant les feuilles de style et le premier rendu : le choix mémorisé
   est posé sur <html> (data-industry-mode) sans scintillement. Sans choix, aucun attribut : la feuille de style suit le réglage
   du système (prefers-color-scheme). Stockage indisponible (navigateur, mode privé) : le mode s'applique à la page, rien n'est
   mémorisé, aucune erreur. Le commutateur est masqué (hidden) tant que ce script n'a pas tourné. Si votre politique CSP interdit
   les scripts inline, ajoutez-y un nonce ou un hash de ce script (voir le README). #}
<script data-industry-color-mode>
(function (window, document) {
    var KEY = 'industry-trade:color-mode';
    var ATTRIBUTE = 'data-industry-mode';
    var TOGGLE = '[data-industry-color-mode-toggle]';
    var root = document.documentElement;

    function stored() {
        try {
            var value = window.localStorage.getItem(KEY);
            return value === 'dark' || value === 'light' ? value : null;
        } catch (error) {
            return null;
        }
    }

    function systemMode() {
        return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function currentMode() {
        return root.getAttribute(ATTRIBUTE) || systemMode();
    }

    function sync() {
        var buttons = document.querySelectorAll(TOGGLE);
        for (var i = 0; i < buttons.length; i++) {
            buttons[i].setAttribute('aria-pressed', currentMode() === 'dark' ? 'true' : 'false');
            buttons[i].removeAttribute('hidden');
        }
    }

    var choice = stored();
    if (choice) {
        root.setAttribute(ATTRIBUTE, choice);
    }

    document.addEventListener('click', function (event) {
        var button = event.target && event.target.closest ? event.target.closest(TOGGLE) : null;
        if (!button) {
            return;
        }
        var next = currentMode() === 'dark' ? 'light' : 'dark';
        root.setAttribute(ATTRIBUTE, next);
        try {
            window.localStorage.setItem(KEY, next);
        } catch (error) {
            // Stockage indisponible : le choix vaut pour cette page seulement.
        }
        sync();
    });

    document.addEventListener('DOMContentLoaded', sync);
    document.addEventListener('turbo:load', sync);
})(window, document);
</script>
