{# US-281 : le cœur donne au lien « Inscription » role="menuitem" sans menu parent (axe aria-required-parent, critère 1.3.1).
   Le lien garde son texte comme nom accessible, comme le lien « Connexion » voisin. #}
{# Point d'extension (0.3.2) : l'application décide de l'affichage via RegistrationLinkPolicyInterface. Par défaut vrai,
   comme dans Sylius. Sans cette condition, une boutique aux inscriptions fermées afficherait ici un lien menant à un 403. #}
{% if industry_theme_registration_link_visible() %}
    {% import '@SyliusShop/shared/buttons.html.twig' as buttons %}

    <small aria-hidden="true" role="presentation" class="text-black px-1">|</small>
    {{ buttons.transparent(
        path('sylius_shop_register'),
        'sylius.ui.register'|trans,
        'register-page-button',
        null,
        null
    ) }}
{% endif %}
