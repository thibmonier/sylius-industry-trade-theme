{# Thème Industrie & Négoce — liste dense : référence, désignation, stock et prix HT sur une ligne ; en cartes sous 768 px #}
{% import '@SyliusShop/shared/messages.html.twig' as messages %}
{% import '@SyliusShop/shared/macro/money.html.twig' as money %}
{% import 'components/tables.html.twig' as tables %}

{% set resources = hookable_metadata.context.resources %}

{% if resources.data|length > 0 %}
    <div class="industry-quick-find mb-3" data-industry-quick-find hidden
         data-message-none="{{ 'industry_trade.quick_find.none'|trans({}, 'industry_trade') }}"
         data-message-one="{{ 'industry_trade.quick_find.one'|trans({}, 'industry_trade') }}"
         data-message-many="{{ 'industry_trade.quick_find.many'|trans({'%count%': '%count%'}, 'industry_trade') }}">
        <label for="industry-quick-find-input" class="form-label">{{ 'industry_trade.quick_find.label'|trans({}, 'industry_trade') }}</label>
        <div class="industry-quick-find__field">
            <input type="text" id="industry-quick-find-input" class="form-control" autocomplete="off" spellcheck="false"
                   role="combobox" aria-expanded="false" aria-controls="industry-quick-find-list" aria-autocomplete="list"
                   aria-describedby="industry-quick-find-hint" data-industry-quick-find-input>
            <ul id="industry-quick-find-list" class="industry-quick-find__list list-unstyled" role="listbox" hidden
                aria-label="{{ 'industry_trade.quick_find.results'|trans({}, 'industry_trade') }}" data-industry-quick-find-list>
                {% for product in resources.data %}
                    {% set variant = product.enabledVariants.first|default(null) %}
                    {% set reference = variant is not null ? variant.code : product.code %}
                    <li id="industry-quick-find-option-{{ loop.index }}" role="option" hidden
                        data-search="{{ (reference ~ ' ' ~ product.name)|lower }}" data-target="industry-product-link-{{ loop.index }}">
                        <code>{{ reference }}</code> {{ product.name }}
                    </li>
                {% endfor %}
            </ul>
        </div>
        <p id="industry-quick-find-hint" class="form-text mb-0">
            {{ 'industry_trade.quick_find.hint'|trans({}, 'industry_trade') }}
        </p>
        <div class="visually-hidden" role="status" aria-live="polite" data-industry-quick-find-status></div>
    </div>
    <div class="industry-product-list overflow-x-auto" data-industry="product-list" {{ sylius_test_html_attribute('products') }}>
        <table class="table industry-product-table">
            <caption class="visually-hidden">{{ 'industry_trade.list.caption'|trans({}, 'industry_trade') }}</caption>
            {{ tables.header([
                {label: 'industry_trade.list.image'|trans({}, 'industry_trade')},
                {label: 'industry_trade.list.reference'|trans({}, 'industry_trade')},
                {label: 'industry_trade.list.designation'|trans({}, 'industry_trade')},
                {label: 'industry_trade.list.stock'|trans({}, 'industry_trade')},
                {label: 'industry_trade.list.price'|trans({}, 'industry_trade')},
                {label: 'industry_trade.list.actions'|trans({}, 'industry_trade')},
            ]) }}
            <tbody>
                {% for product in resources.data %}
                    {% set variant = product.enabledVariants.first|default(null) %}
                    {% set image = product.imagesByType('thumbnail').first|default(product.images.first|default(null)) %}
                    <tr data-industry="product-row" {{ sylius_test_html_attribute('product', product.code) }}>
                        <td class="industry-product-table__image" data-label="{{ 'industry_trade.list.image'|trans({}, 'industry_trade') }}">
                            {% if image is not null and image %}
                                <img src="{{ image.path|imagine_filter('sylius_shop_product_small_thumbnail') }}" alt="" width="64" height="64" loading="lazy">
                            {% else %}
                                <span class="industry-thumb-placeholder" data-industry="image-placeholder" role="img" aria-label="{{ 'industry_trade.list.no_image'|trans({}, 'industry_trade') }}"></span>
                            {% endif %}
                        </td>
                        <td class="industry-product-table__reference" data-label="{{ 'industry_trade.list.reference'|trans({}, 'industry_trade') }}">
                            <code data-industry="reference">{{ variant is not null ? variant.code : product.code }}</code>
                        </td>
                        <th scope="row" class="industry-product-table__name" data-label="{{ 'industry_trade.list.designation'|trans({}, 'industry_trade') }}">
                            <a id="industry-product-link-{{ loop.index }}" href="{{ path('sylius_shop_product_show', {'slug': product.slug, '_locale': product.translation.locale}) }}" {{ sylius_test_html_attribute('product-name', product.name) }}>{{ product.name }}</a>
                        </th>
                        <td class="industry-product-table__stock" data-label="{{ 'industry_trade.list.stock'|trans({}, 'industry_trade') }}">
                            {% if variant is null %}
                                <span class="industry-stock industry-stock--out" data-industry="stock">{{ 'sylius.ui.unavailable'|trans }}</span>
                            {% else %}
                                {% include 'industry_trade/_stock.html.twig' with {variant: variant} only %}
                            {% endif %}
                        </td>
                        {% if variant is null %}
                            <td class="industry-product-table__price" data-label="{{ 'industry_trade.list.price'|trans({}, 'industry_trade') }}"><span data-industry="price-hidden">–</span></td>
                            <td class="industry-product-table__actions" data-label="{{ 'industry_trade.list.actions'|trans({}, 'industry_trade') }}"></td>
                        {% else %}
                            {{ component('sylius_shop:product:card', { product: product, template: '@TmonierSyliusIndustryTradeTheme/product/row_cells.html.twig', hookableMetadata: hookable_metadata }) }}
                        {% endif %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% include 'industry_trade/_quick_find_script.html.twig' %}
{% else %}
    {{ messages.info('sylius.ui.no_results_to_display') }}
{% endif %}
