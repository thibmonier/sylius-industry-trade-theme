{
    "name": "tmonier/sylius-industry-trade-theme",
    "type": "sylius-theme",
    "description": "Thème Industrie & Négoce pour Sylius — haute densité d'information, mode sombre AAA, saisie rapide",
    "keywords": ["sylius", "theme", "b2b", "industry", "trade", "ecommerce", "sylius-theme"],
    "homepage": "https://github.com/thibmonier/sylius-industry-trade-theme",
    "license": "MIT",
    "authors": [
        {
            "name": "Thibaut Monier",
            "email": "thibaut.monier@gmail.com",
            "homepage": "https://www.linkedin.com/in/thibautmonier/"
        }
    ],
    "require": {
        "php": "^8.3",
        "sylius/theme-bundle": "^2.4",
        "sylius/sylius": "^2.2 || ^2.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5",
        "rector/rector": "^1.0",
        "sylius-labs/coding-standard": "^4.4",
        "sylius/test-application": "^2.0.0@alpha",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/debug-bundle": "^7.4 || ^8.0",
        "symfony/dotenv": "^7.4 || ^8.0",
        "symfony/intl": "^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^7.4 || ^8.0",
        "symfony/webpack-encore-bundle": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Tmonier\\SyliusIndustryTradeTheme\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tmonier\\SyliusIndustryTradeTheme\\Tests\\": "tests/"
        }
    },
    "extra": {
        "sylius-theme": {
            "title": "Industrie & Négoce",
            "description": "Thème B2B optimisé pour l'industrie et le négoce — haute densité d'information, contrastes AAA, saisie rapide"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
